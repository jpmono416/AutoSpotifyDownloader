# Local application URL. OAuth callbacks are derived from this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase transaction pooler or Railway Postgres connection string.
DATABASE_URL=postgresql://postgres:password@host:6543/postgres

# 32 random bytes encoded as base64. Keep old versions available during a future rotation.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# QA exports are deny-by-default and also require a row in qa_download_allowlist.
DOWNLOADS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DOWNLOAD_BUCKET=qa-downloads
DOWNLOAD_TEMP_ROOT=/data/jobs
WORKER_POLL_MS=3000
WORKER_HEARTBEAT_MS=15000
YOUTUBE_USER_DAILY_BUDGET=2000
YOUTUBE_GLOBAL_DAILY_BUDGET=9000
ADMIN_USER_IDS=

# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID with application type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/auth/soundcloud/callback
