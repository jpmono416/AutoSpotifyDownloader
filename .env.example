# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google / YouTube — https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Web application credentials (not Desktop)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# SoundCloud — https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
